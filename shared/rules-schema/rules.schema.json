{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuleSet",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "version": {
      "description": "Format version (currently 1).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "$defs": {
    "Matcher": {
      "description": "Request matching. Every field that is set must match; `host` and `path` accept `*`.",
      "type": "object",
      "properties": {
        "filter": {
          "description": "Any extra condition in the search language, e.g. `status:5xx header:x-env=staging`.",
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "description": "e.g. `api.acmeshop.com`, `*.acmeshop.com` (a bare domain also matches its subdomains).",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "e.g. `/v2/checkout`, `/v2/products/*` (without `*`, a prefix match).",
          "type": [
            "string",
            "null"
          ]
        },
        "scheme": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Phase": {
      "type": "string",
      "enum": [
        "request",
        "response",
        "both"
      ]
    },
    "RewriteAction": {
      "oneOf": [
        {
          "description": "Set a value at a JSON path in the body (`$.a.b[0].c`).",
          "type": "object",
          "properties": {
            "set_json": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "value": true
              },
              "required": [
                "path",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "set_json"
          ]
        },
        {
          "description": "Remove a key at a JSON path.",
          "type": "object",
          "properties": {
            "remove_json": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "remove_json"
          ]
        },
        {
          "type": "object",
          "properties": {
            "set_header": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "set_header"
          ]
        },
        {
          "type": "object",
          "properties": {
            "remove_header": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "remove_header"
          ]
        },
        {
          "type": "object",
          "properties": {
            "set_status": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "set_status"
          ]
        },
        {
          "description": "Replace text in the body (literal unless `regex: true`).",
          "type": "object",
          "properties": {
            "replace_body": {
              "type": "object",
              "properties": {
                "find": {
                  "type": "string"
                },
                "regex": {
                  "type": "boolean",
                  "default": false
                },
                "replace": {
                  "type": "string"
                }
              },
              "required": [
                "find",
                "replace"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "replace_body"
          ]
        },
        {
          "description": "Delay the response by this many milliseconds.",
          "type": "object",
          "properties": {
            "delay_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "delay_ms"
          ]
        },
        {
          "description": "Replace the whole body with this text.",
          "type": "object",
          "properties": {
            "set_body": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "set_body"
          ]
        }
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "description": "Stable identifier, unique in the file (letters, digits, `-`, `_`).",
          "type": "string"
        },
        "match": {
          "description": "Which requests the rule applies to.",
          "$ref": "#/$defs/Matcher"
        },
        "name": {
          "description": "Human-readable name shown in the UI.",
          "type": "string",
          "default": ""
        }
      },
      "oneOf": [
        {
          "description": "Edit requests or responses in flight.",
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RewriteAction"
              }
            },
            "kind": {
              "type": "string",
              "const": "rewrite"
            },
            "phase": {
              "$ref": "#/$defs/Phase",
              "default": "response"
            }
          },
          "required": [
            "kind",
            "actions"
          ]
        },
        {
          "description": "Answer from a local file instead of the server.",
          "type": "object",
          "properties": {
            "file": {
              "description": "Path to the body file, relative to the rules file.",
              "type": "string"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "map_local"
            },
            "status": {
              "type": "integer",
              "format": "uint16",
              "default": 200,
              "maximum": 65535,
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "file"
          ]
        },
        {
          "description": "Send the request to another server (e.g. production → staging).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "map_remote"
            },
            "preserve_host": {
              "description": "Keep the original `Host`/`:authority` (for servers that route by host).",
              "type": "boolean",
              "default": false
            },
            "to": {
              "description": "Base URL, e.g. `https://staging.acmeshop.com`; the original path and query are kept.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "to"
          ]
        },
        {
          "description": "Pause matching requests/responses for editing.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "breakpoint"
            },
            "phase": {
              "$ref": "#/$defs/Phase",
              "default": "response"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Refuse matching requests without contacting the server.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "block"
            },
            "status": {
              "type": "integer",
              "format": "uint16",
              "default": 403,
              "maximum": 65535,
              "minimum": 0
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Simulate a slow or lossy network.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "throttle"
            },
            "profile": {
              "$ref": "#/$defs/ThrottleProfile"
            }
          },
          "required": [
            "kind",
            "profile"
          ]
        },
        {
          "description": "Connect to a different address for a host (like an `/etc/hosts` entry, but only for traffic\nthrough Relay). The app still sees the original host name: `Host`, TLS name and certificate\nchecks are unchanged. Only `match.host` is used.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dns_spoof"
            },
            "to": {
              "description": "An IP address (`127.0.0.1`, `10.0.0.7`) or another host name to look up instead.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "to"
          ]
        }
      ],
      "required": [
        "id",
        "match"
      ]
    },
    "ThrottleProfile": {
      "anyOf": [
        {
          "description": "`3g`, `edge`, `lte`, `lte-lossy`, `offline`, `high-latency`.",
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "down_kbps": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "default": null,
              "minimum": 0
            },
            "latency_ms": {
              "type": "integer",
              "format": "uint32",
              "default": 0,
              "minimum": 0
            },
            "loss_pct": {
              "description": "Percentage of packets/requests to drop (0–100).",
              "type": "number",
              "format": "float",
              "default": 0.0
            },
            "up_kbps": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "default": null,
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}