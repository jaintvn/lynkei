<?xml version="1.0" encoding="utf-8"?>
<!-- Debug setting so Relay can read this app's HTTPS: also trust certificates the developer installed
     on the device (Android 7+ apps ignore them by default). Never ship this in a release build. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
